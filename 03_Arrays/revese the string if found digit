void reverse(char * start,char *end)
{
    while(start<end)
    {
        char temp=*start;
        *start=*end;
        *end=temp;
        start++;
        end--;
    }
}
void rev_digit(char *str)
{
    int i=0;
    while(str[i]!='0')
    {
        while(str[i]==' ')
        {
            i++;
        }
        if(str[i]=='\0')
        {
            break;
        }
        int start=i;
        int has_digit=0;
        while(str[i]!=' ' && str[i]!='\0')
        {
            if(str[i]>='0' && str[i]<='9'){
                has_digit=1;
            }
            i++;
        }
        int end=i-1;
        if(has_digit)
        {
            reverse(&str[start],&str[end]);
        }
        
    }
    
}
