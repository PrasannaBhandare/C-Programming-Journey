#include <stdio.h>

void sort(int *p, int e);

int main(void)
{
    int a[5] = {5, 2, 8, 1, 3};
    int ele = sizeof(a) / sizeof(a[0]);

    sort(a, ele);

    for (int i = 0; i < ele; i++) {
        printf("%d ", a[i]);
    }

    printf("\n");
    return 0;
}

void sort(int *p, int e)
{
    int temp;

    for (int i = 0; i < e - 1; i++) {
        for (int j = 0; j < e - 1 - i; j++) {
            if (*(p + j) > *(p + j + 1)) {
                temp = *(p + j);
                *(p + j) = *(p + j + 1);
                *(p + j + 1) = temp;
            }
        }
    }
}
