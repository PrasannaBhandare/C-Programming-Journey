#include<stdio.h>
#include<stdlib.h>
//declaration
int find_sum(int *p,int n);
int main()
{
    int n,i;
    int *p=NULL;
    printf("enter the number of elements:");
    {
        scanf("%d",&n);
    }
    if(n<=0)
    {
        printf("Invalid array size!");
        return 1;
    }
    p=(int*)malloc(n*sizeof(int));
    if(p==NULL)
    {
        printf("memory allocation is failed!\n");
        return 1;
    }
    printf("enter the array elements\n");
    for(i=0;i<n;i++)
    {
        scanf("%d",p+i);
    }
    int total=find_sum(p,n);
    printf("sum of array ele=%d\n",total);

    free(p);
    p=NULL;
    return 0;
}
//defination
int find_sum(int *p,int n)
{
    int i,sum=0;
    for(i=0;i<n;i++)
    {
        sum=sum+*(p+i);
    }
    return sum;
}
