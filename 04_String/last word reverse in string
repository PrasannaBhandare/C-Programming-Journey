#include<stdio.h>
void revese(char *start,char*end);
void rev_vowels(char *str);
int main()
{
    char s[100];
    printf("enter the string:\n");
    scanf("%[^\n]",s);
    rev_vowels(s);
    printf("modified string:\n");
    printf("%s",s);
    return 0;
}
void revese(char *start,char*end)
{
while(start<end)
{
    char temp=*start;
    *start=*end;
    *end=temp;
    start++;
    end--;
}



}
void rev_vowels(char *str)
{
    int end = 0;
    int start;

    while (str[end] != '\0')
        end++;

    end--;  // Last character in the string

    // Ignore trailing spaces.
    while (end >= 0 && str[end] == ' ')
        end--;

    if (end < 0)
        return;

    start = end;

    // Find the beginning of the last word.
    while (start >= 0 && str[start] != ' ')
        start--;

    revese(&str[start + 1], &str[end]);
}
