#include<stdio.h>
int main()
{
    char s[100];
    int i;
    printf("enter the string:\n");
    //scanf("%s",s);
    scanf("%[^\n]",s);
    int lowercase=0;
    int uppercase=0;
    int digit=0;
    int specialchar=0;
    for(i=0;s[i];i++)
    {
    if(s[i]>='a'&&s[i]<='z')
    {
          lowercase++;
    }
    else if(s[i]>='A'&&s[i]<='Z')
    {
        uppercase++;
    }
    else if(s[i]>='0'&&s[i]<='9')
    {
        digit++;
    }
    else
    specialchar++;

    }
    printf("lowercase=%d uppercase=%d digit=%d specialchar=%d \n",lowercase,uppercase,digit,specialchar);
return 0;
}
