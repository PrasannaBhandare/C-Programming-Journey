#include<stdio.h>
int main()
{
    char s[100];
    int i;
    printf("enter the string:\n");
    scanf("%s",s);
    int vowel=0;
    int consonant=0;
    for(i=0;s[i];i++)
    {
    if((s[i] >= 'a' && s[i] <= 'z') ||(s[i] >= 'A' && s[i] <= 'Z'))
    {
         if  ((s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u')||(s[i]=='A' || s[i]=='E' || s[i]=='I' ||
s[i]=='O' || s[i]=='U'))
        vowel++;
         else
        consonant++;
   }
    }
    printf("vowel=%d consonant=%d",vowel,consonant);
return 0;
}
