void reverse(char *start,char *end)
{
    while(start<end)
    {
        char temp=*start;
        *start=*end;
        *end=temp;
        start++;
        end--;
    }
}

int is_india(char *str,int start,int end)
{
    char target[]="india";
    int len=end-start+1;
    if(len!=5)
    {
        return 0;
    }
    for(int i=0;i<5;i++)
    {
        if(str[start+i]!=target[i])
        {
            return 0;
        }
    }
}
void rev_word(char *str)
{
    int i=0;
    while(str[i]!='\0')
    {
        while(str[i]==' ')
        {
            i++;
        }
        if(str[i]=='\0')
        {
            break;
        }
        int start=i;
        while(str[i]!=' ' && str[i]!='\0')
        {
            i++;
        }
        int end=i-1;
        if(is_india(str,start,end))
        {
            reverse(&str[start],&str[end]);
        }
    }
}
