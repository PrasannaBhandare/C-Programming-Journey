#include <stdio.h>

/* Helper function declaration: reverses characters between two pointers */
void reverse(char *start, char *end);

/* Primary function declaration: scans words and reverses if word has '@' or '#' */
void rev_symbol_words(char *str);

int main() {
    char s[200];

    printf("Enter string: ");
    /* Reads string including spaces until newline */
    scanf("%[^\n]s", s);

    /* Pass base address of string array */
    rev_symbol_words(s);

    /* Print the modified string */
    printf("Result: %s\n", s);

    return 0;
}

/* Helper function definition */
void reverse(char *start, char *end) {
    while (start < end) {
        char temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
}

/* Primary function definition */
void rev_symbol_words(char *str) {
    int i = 0;

    while (str[i] != '\0') {
        /* 1. Skip leading/consecutive spaces */
        while (str[i] == ' ') {
            i++;
        }
        if (str[i] == '\0') {
            break;
        }

        /* 2. Track the start of the word and check for symbols */
        int start = i;
        int has_symbol = 0;

        while (str[i] != ' ' && str[i] != '\0') {
            if (str[i] == '@' || str[i] == '#') {
                has_symbol = 1;
            }
            i++;
        }
        int end = i - 1;

        /* 3. If word contains '@' or '#', reverse it */
        if (has_symbol) {
            reverse(&str[start], &str[end]);
        }
    }
}
